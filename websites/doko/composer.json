{
    "name": "doko/ecommerce",
    "description": "DOKO E-commerce System with comprehensive unit testing",
    "type": "project",
    "authors": [
        {
            "name": "DOKO Development Team",
            "email": "dev@doko.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "mockery/mockery": "^1.4",
        "phpunit/phpcov": "*",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Doko\\": "src/",
            "Doko\\Controllers\\": "src/Controllers/",
            "Doko\\Models\\": "src/Models/",
            "Doko\\Services\\": "src/Services/"
        },
        "files": [
            "config/database.php",
            "template/config.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Doko\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit --configuration tests/phpunit.xml"
        ],
        "test-unit": [
            "phpunit --configuration tests/phpunit.xml --testsuite Unit"
        ],
        "test-integration": [
            "phpunit --configuration tests/phpunit.xml --testsuite Integration"
        ],
        "test-api": [
            "phpunit --configuration tests/phpunit.xml --testsuite API"
        ],
        "test-coverage": [
            "phpunit --configuration tests/phpunit.xml --coverage-html coverage/"
        ],
        "test-verbose": [
            "phpunit --configuration tests/phpunit.xml --verbose"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    }
}
